# Copy to .env (chmod 600) and fill in. .env is git-ignored.
PUBLIC_IP=203.0.113.10
SIP_1001_USERNAME=1001
SIP_1001_PASSWORD=change-me-24+-random-chars

# Deepgram (https://console.deepgram.com): speech-to-text and text-to-speech
DEEPGRAM_API_KEY=
# Groq (https://console.groq.com): the language model
GROQ_API_KEY=

# Which business profile the agent plays (a file name in profiles/, without .yaml)
ACTIVE_PROFILE=lead_qualification

# Optional app settings (defaults shown)
AUDIOSOCKET_PORT=9092
LOG_LEVEL=INFO
# Agent (phase 2b). AGENT_ENABLED=false -> transcription only (phase 2a)
AGENT_ENABLED=true
GROQ_MODEL=openai/gpt-oss-120b
# Skip the eager head start while less than this share of Groq's per-minute token allowance is left
GROQ_EAGER_MIN_BUDGET=0.4
AURA_MODEL=aura-2-thalia-en
FLUX_MODEL=flux-general-en
FLUX_EOT_THRESHOLD=0.7
# 0 disables the eager head start (fewer LLM requests, slightly slower replies)
FLUX_EAGER_EOT_THRESHOLD=0.5
FLUX_EOT_TIMEOUT_MS=3000
# Fast barge-in: local voice detection pauses the bot before speech-to-text confirms
BARGE_VAD_ENABLED=true
BARGE_VAD_MODE=3
# Raise this if the bot pauses on its own echo (speakerphone)
BARGE_MIN_RMS=500
BARGE_MIN_SPEECH_MS=120
BARGE_CONFIRM_MS=2500
# Silence after the closing line before hanging up
END_SILENCE_MS=1500
# Sound on the line can stretch that wait, but never beyond this in total
END_SILENCE_MAX_MS=3000
# Debug ONLY, test calls only: save caller audio to data/recordings/ (auto-deleted after 7 days)
DEBUG_RECORD_AUDIO=false
# Transcription-only mode (phase 2a) settings
STT_ENABLED=true
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_ENDPOINTING_MS=400
DEEPGRAM_UTTERANCE_END_MS=1000
# Debug: play the caller's own audio back after ECHO_DELAY_MS
ECHO_MODE=false
ECHO_DELAY_MS=1000
# Where Asterisk leaves per-call RTP statistics at hang-up (see asterisk/extensions.conf)
RTP_STATS_DIR=/var/lib/voice-agent-rtp
